# .env.example
ENV=development

DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/style_store?charset=utf8mb4

SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://custom.local

# Email (SMTP) — для отправки писем (сброс пароля, подтверждение заказа)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com
FRONTEND_URL=http://custom.local

# ЮKassa — для онлайн-оплаты
# Получить на: https://yookassa.ru/my/shop-settings/integration
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
